# ============================================================================
# PET CARE & SERVICES MARKETPLACE - ENVIRONMENT CONFIGURATION
# ============================================================================
#
# Obtain these credentials from your Supabase Dashboard:
# 1. Project URL:
#    Supabase Dashboard -> Project Settings -> API -> Project URL
# 2. Publishable / Anon Public Key:
#    Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
#    (or the new publishable key starting with "pk_...")
#
# SECURITY WARNING:
# NEVER expose your 'service_role' secret key in this frontend file!
# RLS policies protect your database through the anon/publishable key.
# ============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here

# Optional fallback alias (supports both variable names)
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key-here
